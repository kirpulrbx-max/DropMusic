{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "Permisos solo de escritorio: actualizaciones automáticas, reinicio y efecto de cristal de la ventana.",
  "platforms": [
    "windows",
    "linux",
    "macOS"
  ],
  "windows": [
    "main"
  ],
  "permissions": [
    "updater:default",
    "process:allow-restart",
    "core:window:allow-set-effects"
  ]
}
